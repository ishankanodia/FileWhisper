# Copy to .env. Left as is, FileWhisper answers entirely on this computer with
# the built-in on-device model, which is also what it does with no .env at all.
# Nothing you ask and no document text leaves the machine.
LLM_PROVIDER=local
# One of the ids in MODEL_CATALOG (filewhisper/local_llm.py):
#   qwen3-1.7b (default, 1.4 GB) | qwen3-0.6b (0.4 GB) | phi-3.5-mini (2.8 GB) | llama-3.2-1b (1.9 GB)
# Leave unset to take the default; a stale value here also applies if you later
# switch provider without naming a model.
# LLM_MODEL=qwen3-1.7b

# A local model server you already run (Ollama, LM Studio, llama.cpp, Jan).
# Also fully private. The port is auto-detected, so LLM_BASE_URL is optional.
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# --- Everything below sends your question and the matched snippets to a
# --- third party. Only use these if you want more speed or accuracy.

# Free keyless cloud assistant:
# LLM_PROVIDER=free-huggingface
# LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# HF_API_KEY=replace_with_your_key

# Groq alternative:
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=replace_with_your_key

# OpenAI alternative:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5-mini
# OPENAI_API_KEY=replace_with_your_key

# Anthropic Claude alternative:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=replace_with_your_key

# Google Gemini alternative:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=replace_with_your_key

# Custom OpenAI-compatible alternative:
# LLM_PROVIDER=custom
# LLM_MODEL=your-model-name
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=replace_with_your_key
