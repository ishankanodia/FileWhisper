# Copy to .env. Left as is, FileWhisper runs on the free keyless assistant,
# which is also what the app defaults to when there is no .env at all.
LLM_PROVIDER=free-huggingface
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# Optional: a Hugging Face token raises this provider's rate limits.
# HF_API_KEY=replace_with_your_key

# Groq alternative:
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=replace_with_your_key

# OpenAI alternative:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5-mini
# OPENAI_API_KEY=replace_with_your_key

# Anthropic Claude alternative:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=replace_with_your_key

# Google Gemini alternative:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=replace_with_your_key

# Custom OpenAI-compatible alternative:
# LLM_PROVIDER=custom
# LLM_MODEL=your-model-name
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=replace_with_your_key
